# Build artifacts
*.o
*.so
*.so.debug
*.so.full
*.pico
*.pieo

# bmake dependency files
.depend.*

# Compiled manpages
*.gz

# Binary package build (make package)
*.pkg
pkgwork/

# Package signing material -- never commit the private key or signatures.
# The public key (pkg-be-plugin.pub) is NOT ignored and should be committed.
*.key
*.sig

# Debug symbols
*.dSYM/

# Editor swap/backup files
*.swp
*.swo
*~
.DS_Store

# Test artifacts
tests/*.o
tests/test_runner
tests/*.tap

# Compiled ATF test programs and their split debug files
tests/test_config
tests/test_prune
tests/test_naming
tests/*.debug
tests/*.full
